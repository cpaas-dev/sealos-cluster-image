version = 4
root = "{{ .criData }}"
state = "/run/containerd"
oom_score = 0

[debug]
  level = "warn"

[timeouts]
  "io.containerd.timeout.shim.cleanup" = "5s"
  "io.containerd.timeout.shim.load" = "5s"
  "io.containerd.timeout.shim.shutdown" = "3s"
  "io.containerd.timeout.task.state" = "2s"

[plugins]
  [plugins."io.containerd.server.v1.grpc"]
    address = "/run/containerd/containerd.sock"
    uid = 0
    gid = 0
    max_recv_message_size = 16777216
    max_send_message_size = 16777216

  [plugins."io.containerd.server.v1.debug"]
    address = "/run/containerd/containerd-debug.sock"
    uid = 0
    gid = 0

  [plugins."io.containerd.cri.v1.images"]
    snapshotter = "overlayfs"
    max_concurrent_downloads = 20
    use_local_image_pull = true
    [plugins."io.containerd.cri.v1.images".pinned_images]
      sandbox = "{{ .registryDomain }}:{{ .registryPort }}/{{ .sandboxImage }}"
    [plugins."io.containerd.cri.v1.images".registry]
      config_path = "/etc/containerd/certs.d"

  [plugins."io.containerd.cri.v1.runtime"]
    max_container_log_line_size = 16384
    disable_apparmor = {{ .disableApparmor }}
    [plugins."io.containerd.cri.v1.runtime".containerd]
      default_runtime_name = "crun"
      [plugins."io.containerd.cri.v1.runtime".containerd.runtimes.runc]
        runtime_type = "io.containerd.runc.v2"
        [plugins."io.containerd.cri.v1.runtime".containerd.runtimes.runc.options]
          SystemdCgroup = true
      [plugins."io.containerd.cri.v1.runtime".containerd.runtimes.crun]
        runtime_type = "io.containerd.runc.v2"
        [plugins."io.containerd.cri.v1.runtime".containerd.runtimes.crun.options]
          BinaryName = "{{ default "/usr/bin" .BIN_DIR }}/crun"
          SystemdCgroup = true

  # Read only by `sealctl cri cgroup-driver` (sealos v5.1.1 parses the v2 schema);
  # containerd 2.x ignores these keys. Keep in sync with the cri.v1.runtime section.
  [plugins."io.containerd.grpc.v1.cri".containerd]
    default_runtime_name = "crun"
    [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.crun.options]
      SystemdCgroup = true
