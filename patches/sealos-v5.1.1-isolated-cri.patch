--- a/lifecycle/pkg/checker/host_checker.go
+++ b/lifecycle/pkg/checker/host_checker.go
@@ -124,6 +124,18 @@ func (a ContainerdChecker) Check(cluster *v2.Cluster, _ string) error {
 	if err != nil {
 		return err
 	}
+	for _, setting := range cluster.Spec.Env {
+		if setting != "SEALOS_ISOLATED_CRI=true" {
+			continue
+		}
+		for _, ip := range ipList {
+			_, err := execer.Cmd(ip, "if systemctl is-active --quiet containerd-v137; then systemctl show -p ExecStart --value containerd-v137 | grep -Fq '/opt/sealos-v137/bin/containerd --config /etc/containerd-v137/config.toml'; fi")
+			if err != nil {
+				return fmt.Errorf("conflicting containerd-v137 service on %s: %w", ip, err)
+			}
+		}
+		return nil
+	}
 	return checkContainerd(execer, ipList)
 }
 
